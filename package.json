{
  "name": "pawmetry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "quota:probe": "node tools/codex-quota-probe/cli.ts",
    "activity:probe": "node tools/codex-activity-probe/cli.ts",
    "simulate": "node tools/simulation.ts",
    "desktop": "node tools/launch-desktop.mjs",
    "desktop:smoke": "node tools/launch-desktop.mjs --smoke-test",
    "desktop:smoke-live": "node tools/launch-desktop.mjs --smoke-live",
    "desktop:smoke-lock": "node tools/test-desktop-lock.mjs",
    "vscode:smoke-ipc": "node tools/test-vscode-ipc.ts",
    "build:local": "node tools/build-local.mjs",
    "package:local": "node tools/build-local.mjs --package",
    "test": "node --test tests/*.test.ts"
  },
  "devDependencies": {
    "electron": "45.5.0"
  }
}
