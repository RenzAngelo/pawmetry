{
  "name": "pawmetry",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "quota:probe": "node tools/codex-quota-probe/cli.ts",
    "simulate": "node tools/simulation.ts",
    "mascot:check": "node tools/validate-cat-atlas.mjs",
    "mascot:repack": "node tools/repack-cat-atlas.mjs",
    "mascot:preview": "node tools/make-cat-preview.mjs",
    "branding:render": "powershell.exe -NoProfile -File tools/render-branding.ps1",
    "desktop": "node tools/launch-desktop.mjs",
    "desktop:smoke": "node tools/launch-desktop.mjs --smoke-test",
    "desktop:smoke-live": "node tools/launch-desktop.mjs --smoke-live",
    "desktop:smoke-performance": "node tools/launch-desktop.mjs --smoke-performance",
    "desktop:smoke-lock": "node tools/test-desktop-lock.mjs",
    "vscode:smoke-ipc": "node tools/test-vscode-ipc.ts",
    "build:local": "node tools/build-local.mjs",
    "package:local": "node tools/build-local.mjs --package",
    "package:cat-review": "node tools/validate-cat-atlas.mjs assets/mascots/cat/sprites.png && node tools/build-local.mjs --package --cat-review",
    "package:single-install": "node tools/build-local.mjs --package --bundle-companion",
    "package:single-install:cat": "node tools/validate-cat-atlas.mjs assets/mascots/cat/sprites.png && node tools/build-local.mjs --package --bundle-companion --cat-review",
    "package:public-preview": "node tools/build-local.mjs --package --bundle-companion --public-release",
    "test": "node --test tests/*.test.ts"
  },
  "devDependencies": {
    "electron": "45.5.0",
    "resedit": "3.1.0"
  }
}
